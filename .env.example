NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME=DevAssess API
APP_BASE_URL=http://localhost:5000
CANDIDATE_APP_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev_assess?schema=public
REDIS_URL=redis://localhost:6379

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
MAINTENANCE_JOBS_ENABLED=true
MAINTENANCE_JOB_INTERVAL_MS=60000
MAINTENANCE_JOB_BATCH_SIZE=100

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
SENSITIVE_DATA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=devassess_refresh

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback
GOOGLE_OAUTH_STATE_TTL_SECONDS=600

# bKash Tokenized Checkout sandbox
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/payments/bkash/callback
BKASH_TIMEOUT_MS=30000

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=DevAssess <no-reply@devassess.local>
# Development seed credentials. Replace before running seeds outside local development.
SEED_ADMIN_EMAIL=admin@devassess.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_DEMO_DATA=true

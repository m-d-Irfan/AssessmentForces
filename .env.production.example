POSTGRES_DB=dev_assess
POSTGRES_USER=dev_assess
POSTGRES_PASSWORD=replace-with-a-strong-database-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
DATABASE_URL=postgresql://dev_assess:replace-with-a-url-encoded-database-password@postgres:5432/dev_assess?schema=public
REDIS_URL=redis://:replace-with-a-url-encoded-redis-password@redis:6379/0
API_PORT=5000

APP_NAME=DevAssess API
APP_BASE_URL=https://api.example.com
CANDIDATE_APP_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/auth/google/callback
EMAIL_FROM=DevAssess <no-reply@example.com>
BKASH_CALLBACK_URL=https://api.example.com/api/v1/payments/bkash/callback

JWT_ACCESS_SECRET=replace-with-at-least-32-cryptographically-random-characters
SENSITIVE_DATA_ENCRYPTION_KEY=replace-with-a-different-32-character-random-secret

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

LOG_LEVEL=info
METRICS_ENABLED=true
METRICS_TOKEN=replace-with-a-long-random-monitoring-token
MAINTENANCE_JOBS_ENABLED=true
